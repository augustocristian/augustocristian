---
// Lazy, privacy-friendly YouTube embed: static thumbnail facade; the
// youtube-nocookie iframe is created only on click, so no YouTube cookies
// load until the user explicitly plays. No-JS fallback: the facade is a
// plain link to the video on YouTube.
const { url, label = 'YouTube' } = Astro.props;

function youtubeId(u) {
  const m = String(u ?? '').match(
    /(?:youtu\.be\/|youtube(?:-nocookie)?\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/))([\w-]{11})/,
  );
  return m ? m[1] : '';
}
const id = youtubeId(url);
---
{id && (
  <div class="video-embed">
    <a class="video-facade" href={`https://www.youtube.com/watch?v=${id}`}
       target="_blank" rel="noopener" data-video-id={id}>
      <img class="video-thumb" src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
           alt="" loading="lazy" decoding="async" width="480" height="360" />
      <span class="video-play" aria-hidden="true"></span>
      <span class="video-label">{label}</span>
    </a>
  </div>
)}
<script>
  // Swap facade -> nocookie iframe on first click (autoplay rides the click gesture).
  document.querySelectorAll('.video-facade').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.className = 'video-iframe';
      iframe.src = `https://www.youtube-nocookie.com/embed/${a.dataset.videoId}?autoplay=1`;
      iframe.title = a.querySelector('.video-label')?.textContent || 'YouTube';
      iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
      iframe.setAttribute('allowfullscreen', '');
      a.closest('.video-embed').replaceChildren(iframe);
    });
  });
</script>

---
import LinkButtonRow from './LinkButtonRow.astro';
// headingLevel: 3 under the homepage section head, 2 on the talks page.
const { talk, t, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}`;
---
<article class="card talk-card" id={talk.id}>
  <img src={`/${talk.image}`} alt={talk.title} loading="lazy" decoding="async" />
  <p class="talk-meta">{talk.date_range} · {talk.location}</p>
  <Heading>{talk.has_event_url
    ? <a href={talk.event_url} target="_blank" rel="noopener">{talk.title}</a>
    : talk.title}</Heading>
  <p>{talk.summary}</p>
  {talk.abstract && (
    <details class="pub-abstract-details">
      <summary>{t.talk_abstract}</summary>
      <p class="pub-abstract">{talk.abstract}</p>
    </details>
  )}
  <LinkButtonRow links={talk.links} />
</article>

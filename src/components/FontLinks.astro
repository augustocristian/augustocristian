---
// The site's webfont <link>s — declared in one place so every layout loads the
// same families. (They drifted once: a second layout kept requesting a family
// the site had dropped, and its headings silently fell back to Georgia.)
//
// Keep the families here in step with --font-display / --font-body in
// src/styles/core/tokens.css. Loaded non-render-blocking via the media="print"
// swap trick; the <noscript> copy covers script-disabled browsers.
const HREF =
  'https://fonts.googleapis.com/css2' +
  '?family=Inter:wght@400;500;600;700;800' +
  '&family=Noto+Sans+Display:wght@400..700' +
  '&display=swap';
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" media="print" onload="this.media='all'" href={HREF} />
<noscript><link rel="stylesheet" href={HREF} /></noscript>

---
// Filtered TFG/TFM list — shared by both sections of the teaching index.
// Props: sectionId ('tfgs'|'tfms'), listId ('tfg-list'|'tfm-list'), heading,
// isAlt (alternating background), result (from buildThesisViewModels),
// emptyMessage (shown when there are no items; omit to render nothing), t.
import FilterBar from './FilterBar.astro';
import AuthorChip from './AuthorChip.astro';
import { loadIcon } from '../lib/icons.js';

const { sectionId, listId, heading, isAlt, result, emptyMessage = '', t } = Astro.props;
const { items, filterYears, filterDegrees, filterKeywords, filterInstitutions } = result;
const hasItems = items.length > 0;
const iconDoc = loadIcon('external-link');
const iconRepo = loadIcon('code');

const filterGroups = [
  ...(filterInstitutions.length > 1
    ? [{ label: t.teaching_filter_institution, filter: 'institution', kind: 'logo',
         options: filterInstitutions.map((f) => ({ value: f.value, logo_path: f.logo_path, title: f.name })) }]
    : []),
  ...(filterYears.length > 1
    ? [{ label: t.teaching_filter_year, filter: 'year', options: filterYears }]
    : []),
  ...(filterDegrees.length > 1
    ? [{ label: t.teaching_filter_degree, filter: 'degree', options: filterDegrees }]
    : []),
  ...(filterKeywords.length > 0
    ? [{ label: t.teaching_filter_keywords, filter: 'keywords', options: filterKeywords }]
    : []),
];
---
<section class={`section${isAlt ? ' section-alt' : ''}`} id={sectionId}>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.teaching_students_eyebrow}</p>
      <h2>{heading}</h2>
    </div>
    {hasItems && (
      <Fragment>
      <FilterBar groups={filterGroups} target={`#${listId}`} total={items.length}
                 countSuffix={t.teaching_filter_projects} resetLabel={t.teaching_filter_reset}
                 searchable searchField="student" searchPlaceholder={t.teaching_filter_student} />
      <div class="grid grid-2 thesis-cards" id={listId}>
        {items.map((item) => (
          <article class="card thesis-card" data-filter-item
                   data-year={item.year}
                   data-degree={item.degree_slug}
                   data-institution={item.institution_slug}
                   data-keywords={item.keywords_data}
                   data-student={item.student_lower}>
            <div class="thesis-header">
              {item.has_institution_logo && <img class="thesis-institution-logo" src={`/${item.institution_logo}`} alt="" />}
              <div class="thesis-meta">
                <span class="badge">{item.year}</span>
                <span class="text-muted">{item.student}</span>
              </div>
            </div>
            <h4>{item.title}</h4>
            {item.has_cosupervisor && <p class="thesis-cosupervisor"><span class="thesis-cosupervisor-label">{t.teaching_cosupervisor}</span> <AuthorChip author={item.cosupervisor} /></p>}
            {item.has_keywords && (
              <div class="thesis-keywords">{item.keywords.map((k) => <span class="tag">{k.keyword}</span>)}</div>
            )}
            {item.has_abstract && (
              <details class="thesis-abstract">
                <summary>{t.teaching_abstract}</summary>
                <p>{item.abstract}</p>
              </details>
            )}
            {item.has_links && (
              <div class="btn-row">
                {item.has_documentation && <a class="btn btn-sm" href={item.documentation} target="_blank" rel="noopener"><Fragment set:html={iconDoc} /> {t.teaching_documentation}</a>}
                {item.has_repo && <a class="btn btn-sm" href={item.repo} target="_blank" rel="noopener"><Fragment set:html={iconRepo} /> {t.teaching_repository}</a>}
              </div>
            )}
          </article>
        ))}
      </div>
      </Fragment>
    )}
    {!hasItems && emptyMessage && <p class="text-muted">{emptyMessage}</p>}
  </div>
</section>

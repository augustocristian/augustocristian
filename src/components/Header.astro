---
// Sticky nav with GIIS logo, language switcher and theme toggle.
import { langLinks, prefixFor } from '../lib/i18n.js';
import { loadIcon } from '../lib/icons.js';
import { loadProfile } from '../lib/data.js';

const { lang, t, pagePath = '' } = Astro.props;
const prefix = prefixFor(lang);
const profile = loadProfile();

// Subject pages (teaching/<id>/) highlight the Teaching nav item.
const navPath = pagePath.startsWith('teaching/') ? 'teaching/' : pagePath;
const currentUrl = `${prefix}${navPath}`;

const nav = [
  { url: prefix,                   label: t.nav_home },
  { url: `${prefix}publications/`, label: t.nav_publications },
  { url: `${prefix}talks/`,        label: t.nav_talks },
  { url: `${prefix}projects/`,     label: t.nav_projects },
  { url: `${prefix}teaching/`,     label: t.nav_teaching },
  { url: `${prefix}experience/`,   label: t.nav_experience },
].map((item) => ({ ...item, active: item.url === currentUrl }));

const links = langLinks(lang, pagePath);
---
<header class="site-header">
  <div class="container nav">
    <a class="nav-logo" href={prefix} aria-label={`${profile.site_title} — ${t.nav_aria_home}`}>
      <img src="/img/org/org-giis.svg" alt="GIIS" class="nav-logo-img" />
    </a>
    <ul class="nav-links" id="nav-links">
      {nav.map((item) => (
        <li><a href={item.url} aria-current={item.active ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <nav class="lang-switcher" aria-label={t.nav_aria_lang}>
      {links.map((l) => (
        <a href={l.url} aria-current={l.active ? 'true' : undefined} hreflang={l.lang}>{l.code}</a>
      ))}
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label={t.nav_aria_theme}>
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <button class="nav-toggle" id="nav-toggle" type="button" aria-label={t.nav_aria_menu} aria-expanded="false" aria-controls="nav-links">
      <span class="icon-menu" set:html={loadIcon('menu')} />
      <span class="icon-close" set:html={loadIcon('close')} />
    </button>
  </div>
</header>

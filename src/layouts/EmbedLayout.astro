---
// Bare shell for embeddable pages (Campus Virtual / Moodle iframes): the same
// stylesheet and theme handling as the rest of the site, but no site header,
// no footer and no navigation — just a slim title bar and the content.
//
// Embed URLs are `noindex` so they never compete with the canonical page in
// search results; `canonical` still points at the real page.
import '../styles/main.css';

const { lang, t, title, canonical, fullUrl } = Astro.props;
---
<!DOCTYPE html>
<html lang={t.html_lang} class="is-embed-doc">
<head>
  <meta charset="UTF-8" />
  <!-- FOUC prevention: apply the stored theme before any CSS parses. Must stay
       inline and synchronous — do not remove is:inline. -->
  <script is:inline>try{var _t=localStorage.getItem('theme');if(_t==='light'||_t==='dark')document.documentElement.setAttribute('data-theme',_t)}catch(e){}</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/img/favicon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" media="print" onload="this.media='all'"
        href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700;900&display=swap" />
  <noscript>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700;900&display=swap" />
  </noscript>
</head>
<body class="embed-body">
  <header class="embed-bar">
    <h1 class="embed-title">{title}</h1>
    <div class="embed-actions">
      <button class="embed-theme-toggle" type="button" data-theme-toggle
              aria-label={t.nav_aria_theme}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
      </button>
      <!-- target="_blank" so the link escapes the iframe rather than replacing
           the embedded view inside it. -->
      <a class="btn btn-sm btn-outline" href={fullUrl} target="_blank" rel="noopener">
        {t.teaching_open_full}
      </a>
    </div>
  </header>

  <main id="main" class="embed-main">
    <slot />
  </main>

  <script>
    // Theme toggle only — the embed has no nav, filters or scroll reveal, so it
    // deliberately does not load the site's main bundle.
    const root = document.documentElement;
    const stored = localStorage.getItem('theme');
    const current = () =>
      root.getAttribute('data-theme') ??
      (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    if (stored) root.setAttribute('data-theme', stored);
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) { /* private mode */ }
    });
  </script>
</body>
</html>

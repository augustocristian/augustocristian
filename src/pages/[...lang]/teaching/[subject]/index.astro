---
// Subject page: docs-style layout. A collapsible left sidebar lists the course
// planning plus every lesson grouped Theory/Labs/Seminars; the content area
// shows ONE lesson at a time, driven by the URL hash. All of that lives in
// SubjectContent.astro, shared with the embeddable variant under ./embed/.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SubjectContent from '../../../../components/SubjectContent.astro';
import { LANGS, loadI18n, localize, prefixFor } from '../../../../lib/i18n.js';
import { loadSubjects } from '../../../../lib/data.js';

export function getStaticPaths() {
  const subjects = loadSubjects().filter((s) => !s.hidden);
  return LANGS.flatMap(({ code }) =>
    subjects.map((subject) => ({
      params: { lang: code === 'en' ? undefined : code, subject: subject.id },
      props: { lang: code, subject },
    })),
  );
}

const { lang, subject } = Astro.props;
const t = loadI18n(lang);
const prefix = prefixFor(lang);
const subjectTitle = localize(subject, 'title', lang) || subject.title;
const pagePath = `teaching/${subject.id}/`;
---
<BaseLayout lang={lang} t={t} pagePath={pagePath} title={`${subjectTitle} — ${t.nav_teaching}`} description={t.meta_desc_teaching}>
<main id="main">
  <header class="page-header container">
    <a href={`${prefix}teaching/`} class="subject-back-link">{t.teaching_back}</a>
    <h1>{subjectTitle}</h1>
    {subject.image && <img class="subject-banner" src={`/${subject.image}`} alt="" />}
  </header>

  <div class="container">
    <SubjectContent subject={subject} lang={lang} t={t} />
  </div>
</main>
</BaseLayout>
